import customtkinter as ctk

ctk.set_appearance_mode("System")
ctk.set_default_color_theme("blue")


class LogiTalkApp(ctk.CTk):

    def __init__(self):
        super().__init__()

        self.title("LogiTalk")
        self.geometry("700x500")
        self.minsize(500, 400)

        self.username = "Користувач"

        self.grid_columnconfigure(0, weight=1)
        self.grid_columnconfigure(1, weight=4)
        self.grid_rowconfigure(0, weight=1)

        self.sidebar_frame = ctk.CTkFrame(self, corner_radius=0)
        self.sidebar_frame.grid(row=0, column=0, sticky="nsew", padx=10, pady=10)

        self.sidebar_title = ctk.CTkLabel(
            self.sidebar_frame, text="LogiTalk", font=ctk.CTkFont(size=20, weight="bold")
        )
        self.sidebar_title.pack(padx=20, pady=(20, 10))

        self.theme_label = ctk.CTkLabel(self.sidebar_frame, text="Тема оформлення:")
        self.theme_label.pack(padx=20, pady=(20, 0), anchor="w")

        self.theme_option = ctk.CTkOptionMenu(
            self.sidebar_frame,
            values=["System", "Dark", "Light"],
            command=self.change_theme,
        )
        self.theme_option.pack(padx=20, pady=10)

        self.chat_frame = ctk.CTkFrame(self)
        self.chat_frame.grid(row=0, column=1, sticky="nsew", padx=10, pady=10)
        self.chat_frame.grid_columnconfigure(0, weight=1)
        self.chat_frame.grid_rowconfigure(0, weight=1)
        self.chat_frame.grid_rowconfigure(1, weight=0)

        self.chat_textbox = ctk.CTkTextbox(self.chat_frame, state="disabled", activate_scrollbars=True)
        self.chat_textbox.grid(row=0, column=0, columnspan=2, sticky="nsew", padx=15, pady=15)

        self.input_frame = ctk.CTkFrame(self.chat_frame, fg_color="transparent")
        self.input_frame.grid(row=1, column=0, columnspan=2, sticky="ew", padx=15, pady=(0, 15))
        self.input_frame.grid_columnconfigure(0, weight=1)

        self.message_entry = ctk.CTkEntry(
            self.input_frame, placeholder_text="Введіть повідомлення..."
        )
        self.message_entry.grid(row=0, column=0, sticky="ew", padx=(0, 10))
        self.message_entry.bind("<Return>", lambda event: self.send_message())

        self.send_button = ctk.CTkButton(
            self.input_frame, text="Надіслати", command=self.send_message
        )
        self.send_button.grid(row=0, column=1, sticky="e")

        self.after(100, self.show_registration)

    def show_registration(self):
        dialog = ctk.CTkInputDialog(
            text="Введіть ваше ім'я для входу в чат:", title="Реєстрація LogiTalk"
        )
        input_name = dialog.get_input()

        if input_name and input_name.strip():
            self.username = input_name.strip()

        self.append_system_message(f"Ласкаво просимо, {self.username}!")

    def send_message(self):
        message = self.message_entry.get().strip()
        if message:
            self.chat_textbox.configure(state="normal")
            self.chat_textbox.insert("end", f"[{self.username}]: {message}\n")
            self.chat_textbox.configure(state="disabled")
            self.chat_textbox.see("end")
            self.message_entry.delete(0, "end")

    def append_system_message(self, text):
        self.chat_textbox.configure(state="normal")
        self.chat_textbox.insert("end", f" Системне сповіщення: {text}\n\n")
        self.chat_textbox.configure(state="disabled")
        self.chat_textbox.see("end")

    def change_theme(self, new_theme):
        ctk.set_appearance_mode(new_theme)


if __name__ == "__main__":
    app = LogiTalkApp()
    app.mainloop()
