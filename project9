import customtkinter as ctk

ctk.set_appearance_mode("Dark")
ctk.set_default_color_theme("dark-blue")


class LogiTalkApp(ctk.CTk):

    def __init__(self):
        super().__init__()

        self.title("LogiTalk")
        self.geometry("700x500")
        self.minsize(500, 400)

        self.username = "Користувач"

        self.grid_columnconfigure(0, weight=1)
        self.grid_rowconfigure(0, weight=1)

        self.chat_frame = ctk.CTkFrame(self, corner_radius=15, fg_color="#12101c")
        self.chat_frame.grid(row=0, column=0, sticky="nsew", padx=15, pady=15)
        self.chat_frame.grid_columnconfigure(0, weight=1)
        self.chat_frame.grid_rowconfigure(0, weight=1)
        self.chat_frame.grid_rowconfigure(1, weight=0)

        self.chat_textbox = ctk.CTkTextbox(
            self.chat_frame,
            state="disabled",
            activate_scrollbars=True,
            fg_color="#1a1625",
            border_color="#a855f7",
            border_width=1,
            corner_radius=12,
            font=ctk.CTkFont(family="Consolas", size=14),
        )
        self.chat_textbox.grid(row=0, column=0, columnspan=2, sticky="nsew", padx=20, pady=20)

        self.input_frame = ctk.CTkFrame(self.chat_frame, fg_color="transparent")
        self.input_frame.grid(row=1, column=0, columnspan=2, sticky="ew", padx=20, pady=(0, 20))
        self.input_frame.grid_columnconfigure(0, weight=1)

        self.message_entry = ctk.CTkEntry(
            self.input_frame,
            placeholder_text="Напишіть щось цікаве...",
            fg_color="#1a1625",
            border_color="#4b5563",
            corner_radius=10,
            height=40,
            font=ctk.CTkFont(family="Helvetica", size=13),
        )
        self.message_entry.grid(row=0, column=0, sticky="ew", padx=(0, 12))
        self.message_entry.bind("<Return>", lambda event: self.send_message())

        self.send_button = ctk.CTkButton(
            self.input_frame,
            text="Надіслати 🚀",
            command=self.send_message,
            fg_color="#00f0ff",
            hover_color="#00d8e6",
            text_color="#000000",
            corner_radius=10,
            height=40,
            font=ctk.CTkFont(family="Helvetica", size=13, weight="bold"),
        )
        self.send_button.grid(row=0, column=1, sticky="e")

        self.after(100, self.show_registration)

    def show_registration(self):
        dialog = ctk.CTkInputDialog(
            text="Введіть ваше унікальне ім'я:", title="Вхід у LogiTalk"
        )
        input_name = dialog.get_input()

        if input_name and input_name.strip():
            self.username = input_name.strip()

        self.append_system_message(f"Ласкаво просимо до мережі, {self.username}!")

    def send_message(self):
        message = self.message_entry.get().strip()
        if message:
            self.chat_textbox.configure(state="normal")
            self.chat_textbox.insert("end", f"💬 [{self.username}]: {message}\n\n")
            self.chat_textbox.configure(state="disabled")
            self.chat_textbox.see("end")
            self.message_entry.delete(0, "end")

    def append_system_message(self, text):
        self.chat_textbox.configure(state="normal")
        self.chat_textbox.insert("end", f" ⚙️ [СИСТЕМА]: {text}\n\n")
        self.chat_textbox.configure(state="disabled")
        self.chat_textbox.see("end")


if __name__ == "__main__":
    app = LogiTalkApp()
    app.mainloop()
